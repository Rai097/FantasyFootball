{
  "name": "fantasy-trade-desk",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "NODE_ENV=development tsx watch server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "SKIP_TIMING=1 tsx --test \"server/**/*.test.ts\" \"web/src/**/*.test.ts\" && tsx --test server/auth/v4-api.adversarial.test.ts",
    "yahoo:probe": "tsx scripts/yahoo-probe.mts",
    "yahoo:login": "tsx scripts/yahoo-login.mts"
  },
  "dependencies": {
    "croner": "^11.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "playwright-core": "^1.64.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
