# Yahoo Fantasy API credentials — create an app at https://developer.yahoo.com/apps/create/
# Choose "Installed Application" (or Web) and request the Fantasy Sports "Read" permission.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# Must match the Redirect URI you registered with Yahoo. Leave blank to use the
# out-of-band flow (Yahoo shows you a code that you paste into the app).
YAHOO_REDIRECT_URI=
# Optional: only set if Yahoo reports a permissions error (see docs/YAHOO_SETUP.md)
YAHOO_SCOPE=
PORT=3000

# Discord sign-in (required when NODE_ENV=production; without DISCORD_CLIENT_ID a dev server runs in dev mode,
# where every request is the admin). Create an app at https://discord.com/developers/applications → OAuth2,
# add the redirect PUBLIC_URL/auth/callback. Who may sign in: .data/access.json (see README "Sign-in").
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# At least 32 random characters, e.g. `openssl rand -hex 32`. Changing it signs everyone out.
SESSION_SECRET=
# The site's public address, e.g. https://ff.raibot.us (no trailing slash).
PUBLIC_URL=
